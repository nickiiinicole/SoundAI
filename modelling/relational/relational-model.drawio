<mxfile host="app.diagrams.net">
  <diagram name="relational-model" id="7_d_HJuMdnrEryS0tw8L">
    <mxGraphModel grid="0" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% -------------------------------------\n    %% STRONG ENTITIES AND HIERARCHIES\n    %% -------------------------------------\n    USERS {\n        INT user_id PK\n        VARCHAR email\n        VARCHAR username\n    }\n    FREE_USERS {\n        INT user_id PK,FK\n        INT ads_streamed\n        INT skip_limit\n    }\n    PREMIUM_USERS {\n        INT user_id PK,FK\n        DATE renewal_date\n        VARCHAR payment_method\n    }\n    \n    ARTISTS {\n        INT artist_id PK\n        VARCHAR stage_name\n        VARCHAR country\n    }\n    SOLO_ARTISTS {\n        INT artist_id PK,FK\n        VARCHAR real_name\n        DATE birth_date\n    }\n    BANDS {\n        INT artist_id PK,FK\n        INT formation_year\n        VARCHAR name\n    }\n    \n    ALBUMS {\n        INT album_id PK\n        INT artist_id FK\n        VARCHAR title\n        INT release_year\n    }\n    TRACKS {\n        INT track_id PK\n        INT album_id FK\n        INT remixed_from_id FK\n        VARCHAR track_name\n        INT duration_seconds\n    }\n    \n    PLAYLISTS {\n        INT playlist_id PK\n        INT user_id FK\n        VARCHAR playlist_name\n        DATE creation_date\n        VARCHAR favorite\n    }\n    \n    CHAT_SESSIONS {\n        INT session_id PK\n        INT user_id FK\n        VARCHAR session_title\n        DATE started_at\n    }\n\n    %% -------------------------------------\n    %% WEAK ENTITIES AND N:M RESOLUTION\n    %% -------------------------------------\n    \n    TRACKS_CREDIT {\n        INT track_id PK,FK\n        INT artist_id PK,FK\n        VARCHAR role PK\n        VARCHAR credited_name\n        BOOLEAN is_featured\n    }\n    \n    PLAYLIST_ITEMS {\n        INT playlist_id PK,FK\n        INT order_position PK\n        INT track_id FK\n        DATE added_at\n        VARCHAR comment\n    }\n    \n    CHAT_MESSAGES {\n        INT session_id PK,FK\n        INT message_number PK\n        VARCHAR sender_role\n        TEXT text_content\n    }\n    \n    CHATS_RECOMMENDS {\n        INT session_id PK,FK\n        INT message_number PK,FK\n        INT track_id PK,FK\n    }\n\n    %% -------------------------------------\n    %% FOREIGN KEY (FK) CONNECTIONS\n    %% -------------------------------------\n    \n    %% Hierarchies (1:1 via FK)\n    USERS ||--|| FREE_USERS : \&quot;is_a\&quot;\n    USERS ||--|| PREMIUM_USERS : \&quot;is_a\&quot;\n    ARTISTS ||--|| SOLO_ARTISTS : \&quot;is_a\&quot;\n    ARTISTS ||--|| BANDS : \&quot;is_a\&quot;\n    \n    %% Catalog\n    ARTISTS ||--o{ ALBUMS : \&quot;releases\&quot;\n    ALBUMS ||--|{ TRACKS : \&quot;contains\&quot;\n    \n    %% Reflexive (Remix)\n    TRACKS |o--o{ TRACKS : \&quot;remixed_from\&quot;\n    \n    %% Credits (N:M resolved)\n    ARTISTS ||--o{ TRACKS_CREDIT : \&quot;participates_in\&quot;\n    TRACKS ||--|{ TRACKS_CREDIT : \&quot;has_credits\&quot;\n    \n    %% Playlists and their items\n    USERS ||--o{ PLAYLISTS : \&quot;creates\&quot;\n    PLAYLISTS ||--|{ PLAYLIST_ITEMS : \&quot;identifies\&quot;\n    TRACKS ||--o{ PLAYLIST_ITEMS : \&quot;plays_in\&quot;\n    \n    %% AI Chat and messages\n    USERS ||--o{ CHAT_SESSIONS : \&quot;starts\&quot;\n    CHAT_SESSIONS ||--|{ CHAT_MESSAGES : \&quot;identifies\&quot;\n    \n    %% Chat and Tracks intermediate table (N:M resolved)\n    CHAT_MESSAGES ||--o{ CHATS_RECOMMENDS : \&quot;recommends\&quot;\n    TRACKS ||--o{ CHATS_RECOMMENDS : \&quot;is_recommended\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="UerxvJIBZi3JA9YVl-rP-949">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
