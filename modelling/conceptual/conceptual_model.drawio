        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% ENTIDADES FUERTES (Con notación Barker: #, *, º)\n    USER {\n        ID #user_id\n        TXT *email\n        TXT *username\n    }\n    FREE_USER {\n        NUM *ads_streamed\n    }\n    PREMIUM_USER {\n        DATE *renewal_date\n        TXT ºpayment_method\n    }\n    \n    ARTIST {\n        ID #artist_id\n        TXT *stage_name\n        TXT *country\n    }\n    SOLO_ARTIST {\n        TXT *real_name\n        DATE ºbirth_date\n    }\n    BAND {\n        NUM *formation_year\n        NUM *member_count\n    }\n    \n    ALBUM {\n        ID #album_id\n        TXT *title\n        NUM *release_year\n    }\n    \n    TRACK {\n        ID #track_id\n        TXT *track_name\n        NUM *duration_seconds\n    }\n    \n    PLAYLIST {\n        ID #playlist_id\n        TXT *playlist_name\n        DATE *creation_date\n    }\n    \n    CHAT_SESSION {\n        ID #session_id\n        TXT ºsession_title\n        DATE *started_at\n    }\n\n    %% ENTIDADES DÉBILES (El # indica su parte de la clave)\n    TRACK_CREDIT {\n        TXT #role\n    }\n    \n    PLAYLIST_ITEM {\n        NUM #order_position\n        DATE *added_at\n    }\n    \n    CHAT_MESSAGE {\n        NUM #message_number\n        TXT *sender_role\n        TXT *text_content\n    }\n\n    %% ----------------------------------------------------\n    %% CONEXIONES (Patas de gallo)\n    %% ----------------------------------------------------\n    \n    %% Jerarquías\n    USER ||--o{ FREE_USER : \&quot;is_a (d,t)\&quot;\n    USER ||--o{ PREMIUM_USER : \&quot;is_a (d,t)\&quot;\n    ARTIST ||--o{ SOLO_ARTIST : \&quot;is_a (d,t)\&quot;\n    ARTIST ||--o{ BAND : \&quot;is_a (d,t)\&quot;\n    \n    %% Catálogo Musical\n    ARTIST ||--o{ ALBUM : \&quot;releases\&quot;\n    ALBUM ||--|{ TRACK : \&quot;contains\&quot;\n    \n    %% Reflexiva (Remix)\n    TRACK |o--o{ TRACK : \&quot;remixed_from\&quot;\n    \n    %% Colaboraciones\n    ARTIST ||--o{ TRACK_CREDIT : \&quot;participates\&quot;\n    TRACK ||--|{ TRACK_CREDIT : \&quot;has_credits\&quot;\n\n    %% Playlists\n    USER ||--o{ PLAYLIST : \&quot;creates\&quot;\n    PLAYLIST ||--|{ PLAYLIST_ITEM : \&quot;identifies\&quot;\n    PLAYLIST_ITEM }o--|| TRACK : \&quot;plays\&quot;\n\n    %% Chat IA\n    USER ||--o{ CHAT_SESSION : \&quot;starts\&quot;\n    CHAT_SESSION ||--|{ CHAT_MESSAGE : \&quot;identifies\&quot;\n    CHAT_MESSAGE }o--o{ TRACK : \&quot;recommends\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Bpg2f0t03xSgP7VEzdsM-147">
